
<!-- start filelisting.thtml -->
{block_header}
<div class="dlm-catalog" id="dlm-catalog">
  <header class="dlm-catalog-heading"><div><h2>Downloads</h2><p>Plugins, themes and resources for Geeklog</p></div></header>

<div id="dlm_cat_path">{category_path_link}</div>

{category_selbox}

{search_form}

{category_part}

<div id="dlm_filelist_info"><strong>{filelisting_info}</strong></div>

{sort_menu}

<div class="dlm-catalog-results">{filelisting_records}</div>

<div style="padding:10px;">{page_navigation}</div>

{item_extensions}

{comment_records}

</div>
{block_footer}
<!-- end filelisting.thtml -->
